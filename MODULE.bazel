module(
    name = "terawave",
    version = "1.0.0",
)

bazel_dep(
    name = "platforms",
    version = "1.1.0",
)

register_toolchains("//toolchains/arm:arm64_linux_toolchain")


register_toolchains("//toolchains/riscv:riscv64_linux_toolchain")

# Go build support
bazel_dep(
    name = "rules_go",
    version = "0.62.0",
)

# Gazelle generates and maintains BUILD files for Go packages
bazel_dep(
    name = "gazelle",
    version = "0.52.2",
)

go_sdk = use_extension(
    "@rules_go//go:extensions.bzl",
    "go_sdk",
)

go_sdk.download(
    version = "1.25.0",
)
